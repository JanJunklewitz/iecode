<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <Authors>Jan Junklewitz and the IECode contributors</Authors>
    <Company>IECode</Company>
    <Product>IECode</Product>
    <Copyright>Copyright 2026 Jan Junklewitz and the IECode contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JanJunklewitz/iecode</RepositoryUrl>
    <!-- Lets the Windows-only projects compile on macOS / Linux (they only run on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
