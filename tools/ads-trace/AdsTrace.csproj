<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool, not shipped: forwards ADS requests to a PLC and logs them. Kept out of the cli solution on purpose. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Beckhoff.TwinCAT.Ads" Version="7.0.389" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads.Server" Version="7.0.389" />
  </ItemGroup>
</Project>
