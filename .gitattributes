# TwinCAT files keep their CRLF line endings byte for byte (round-trip tests depend on it)
*.TcPOU -text
*.TcDUT -text
*.TcGVL -text
*.TcIO  -text
*.TcTTO -text
*.TcGTLO -text
*.TcIPO -text
*.TcVMO -text
*.plcproj -text
*.tsproj -text
*.tspproj -text
*.sln -text

# shell scripts must keep LF so Git Bash on Windows can run them
*.sh text eol=lf
