  <POU Name="FB_Motor" Id="{3f2b8c1e-0a4d-4c55-9e0f-7b1a2c3d4e5f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Motor
VAR_INPUT
    bEnable : BOOL;
    fSetSpeed : LREAL;
END_VAR
VAR_OUTPUT
    bRunning : BOOL;
END_VAR
VAR
    _fSpeed : LREAL;
    sInfo : STRING := 'a]]]]><![CDATA[>b';
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bEnable THEN
    _fSpeed := fSetSpeed;
    bRunning := TRUE;
ELSE
    Reset();
END_IF]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{11111111-2222-3333-4444-555555555555}" />
    <Method Name="Start" Id="{a1b2c3d4-0000-0000-0000-000000000001}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC Start : BOOL
VAR_INPUT
    fSpeed : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fSetSpeed := fSpeed;
bEnable := TRUE;
Start := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Speed" Id="{a1b2c3d4-0000-0000-0000-000000000002}">
      <Declaration><![CDATA[PROPERTY Speed : LREAL]]></Declaration>
      <Get Name="Get" Id="{a1b2c3d4-0000-0000-0000-000000000003}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Speed := _fSpeed;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Action Name="Reset" Id="{a1b2c3d4-0000-0000-0000-000000000004}">
      <Implementation>
        <ST><![CDATA[_fSpeed := 0;
bRunning := FALSE;]]></ST>
      </Implementation>
    </Action>
