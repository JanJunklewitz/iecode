<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Name>PLC1</Name>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Interfaces\I_Motor.TcIO">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="POUs\MAIN.TcPOU">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="POUs\Motion\FB_Motor.TcPOU">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Interfaces" />
    <Folder Include="POUs" />
    <Folder Include="POUs\Motion" />
  </ItemGroup>
  <ItemGroup>
    <PlaceholderReference Include="Tc2_Standard">
      <DefaultResolution>Tc2_Standard, * (Beckhoff Automation GmbH)</DefaultResolution>
      <Namespace>Tc2_Standard</Namespace>
    </PlaceholderReference>
    <PlaceholderReference Include="Tc3_MotorLib">
      <DefaultResolution>Tc3_MotorLib, 1.2.0 (Example Machines Ltd)</DefaultResolution>
      <Namespace>Tc3_MotorLib</Namespace>
    </PlaceholderReference>
  </ItemGroup>
</Project>
