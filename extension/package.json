{
  "name": "iecode",
  "displayName": "IECode – Structured Text for TwinCAT",
  "description": "Structured Text for TwinCAT in VS Code: edit .TcPOU/.TcDUT/.TcGVL/.TcIO as plain ST, browse and extend PLC projects, workspaces with libraries and applications, build and deploy with the iecode CLI.",
  "version": "0.0.1",
  "publisher": "iecode",
  "author": "Jan Junklewitz",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanJunklewitz/iecode.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/JanJunklewitz/iecode#readme",
  "bugs": {
    "url": "https://github.com/JanJunklewitz/iecode/issues"
  },
  "keywords": [
    "twincat",
    "structured text",
    "iec 61131-3",
    "plc"
  ],
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "bin": {
    "iecode-st": "./out/src/cli.js"
  },
  "activationEvents": [
    "onFileSystem:iecode",
    "workspaceContains:**/*.{TcPOU,TcDUT,TcGVL,TcIO,plcproj,tsproj,tspproj}"
  ],
  "contributes": {
    "languages": [
      {
        "id": "twincat-st",
        "aliases": [
          "TwinCAT Structured Text"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "xml",
        "extensions": [
          ".TcPOU",
          ".TcDUT",
          ".TcGVL",
          ".TcIO",
          ".TcTTO"
        ]
      }
    ],
    "grammars": [
      {
        "language": "twincat-st",
        "scopeName": "source.twincat-st",
        "path": "./syntaxes/twincat-st.tmLanguage.json"
      },
      {
        "scopeName": "text.xml.twincat-cdata",
        "path": "./syntaxes/cdata-injection.tmLanguage.json",
        "injectTo": [
          "text.xml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.twincat-st": "twincat-st"
        }
      }
    ],
    "snippets": [
      {
        "language": "twincat-st",
        "path": "./snippets.json"
      }
    ],
    "commands": [
      {
        "command": "iecode.openAsST",
        "title": "Open as Structured Text",
        "category": "IECode"
      },
      {
        "command": "iecode.openAsXml",
        "title": "Open as XML",
        "category": "IECode"
      },
      {
        "command": "iecode.build",
        "title": "Build",
        "category": "IECode",
        "icon": "$(play)"
      },
      {
        "command": "iecode.refresh",
        "title": "Refresh",
        "category": "IECode",
        "icon": "$(refresh)"
      },
      {
        "command": "iecode.addObject",
        "title": "Add Object…",
        "category": "IECode",
        "icon": "$(add)"
      },
      {
        "command": "iecode.addMember",
        "title": "Add Method / Property / Action…",
        "category": "IECode",
        "icon": "$(add)"
      },
      {
        "command": "iecode.addFolder",
        "title": "New Folder…",
        "category": "IECode",
        "icon": "$(new-folder)"
      },
      {
        "command": "iecode.rename",
        "title": "Rename…",
        "category": "IECode"
      },
      {
        "command": "iecode.delete",
        "title": "Delete",
        "category": "IECode"
      },
      {
        "command": "iecode.revealMember",
        "title": "Go to Member",
        "category": "IECode"
      },
      {
        "command": "iecode.showGraph",
        "title": "Show Dependency Graph",
        "category": "IECode",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "iecode.check",
        "title": "Check All Objects",
        "category": "IECode",
        "icon": "$(checklist)"
      },
      {
        "command": "iecode.clean",
        "title": "Clean",
        "category": "IECode"
      },
      {
        "command": "iecode.activate",
        "title": "Activate Configuration…",
        "category": "IECode",
        "icon": "$(zap)"
      },
      {
        "command": "iecode.libSave",
        "title": "Save as Library…",
        "category": "IECode",
        "icon": "$(package)"
      },
      {
        "command": "iecode.encrypt",
        "title": "Encrypt / Protect…",
        "category": "IECode",
        "icon": "$(lock)"
      },
      {
        "command": "iecode.buildWorkspace",
        "title": "Build Workspace",
        "category": "IECode",
        "icon": "$(run-all)"
      },
      {
        "command": "iecode.buildAffected",
        "title": "Build Affected Projects",
        "category": "IECode",
        "icon": "$(run-errors)"
      },
      {
        "command": "iecode.selectProject",
        "title": "Select Active Project…",
        "category": "IECode"
      },
      {
        "command": "iecode.selectTcVersion",
        "title": "Select TwinCAT Version…",
        "category": "IECode"
      },
      {
        "command": "iecode.libraries",
        "title": "Manage Libraries",
        "category": "IECode",
        "icon": "$(library)"
      },
      {
        "command": "iecode.installCli",
        "title": "Install CLI…",
        "category": "IECode"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "iecode.openAsST",
          "when": "resourceExtname =~ /\\\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i",
          "group": "navigation"
        },
        {
          "command": "iecode.openAsXml",
          "when": "resourceExtname =~ /\\\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "iecode.openAsST",
          "when": "resourceScheme == file && resourceExtname =~ /\\\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i"
        },
        {
          "command": "iecode.openAsXml",
          "when": "resourceScheme == iecode"
        }
      ],
      "view/title": [
        {
          "command": "iecode.addObject",
          "when": "view == iecode.projects",
          "group": "navigation@1"
        },
        {
          "command": "iecode.libraries",
          "when": "view == iecode.projects",
          "group": "navigation@2"
        },
        {
          "command": "iecode.showGraph",
          "when": "view == iecode.projects",
          "group": "navigation@2"
        },
        {
          "command": "iecode.refresh",
          "when": "view == iecode.projects",
          "group": "navigation@3"
        },
        {
          "command": "iecode.buildWorkspace",
          "when": "isWindows && view == iecode.projects",
          "group": "1_build@1"
        },
        {
          "command": "iecode.buildAffected",
          "when": "isWindows && view == iecode.projects",
          "group": "1_build@2"
        },
        {
          "command": "iecode.selectProject",
          "when": "view == iecode.projects",
          "group": "2_settings@1"
        },
        {
          "command": "iecode.selectTcVersion",
          "when": "view == iecode.projects",
          "group": "2_settings@2"
        }
      ],
      "view/item/context": [
        {
          "command": "iecode.addObject",
          "when": "view == iecode.projects && viewItem =~ /^(unit|folder)/",
          "group": "inline"
        },
        {
          "command": "iecode.addObject",
          "when": "view == iecode.projects && viewItem =~ /^(unit|folder)/",
          "group": "1_add@1"
        },
        {
          "command": "iecode.addFolder",
          "when": "view == iecode.projects && viewItem =~ /^(unit|folder)/",
          "group": "1_add@2"
        },
        {
          "command": "iecode.addMember",
          "when": "view == iecode.projects && viewItem =~ /^object\\.(FUNCTION_BLOCK|PROGRAM|INTERFACE)$/",
          "group": "inline"
        },
        {
          "command": "iecode.addMember",
          "when": "view == iecode.projects && viewItem =~ /^object\\.(FUNCTION_BLOCK|PROGRAM|INTERFACE)$/",
          "group": "1_add@1"
        },
        {
          "command": "iecode.openAsST",
          "when": "view == iecode.projects && viewItem =~ /^object/",
          "group": "2_open@1"
        },
        {
          "command": "iecode.openAsXml",
          "when": "view == iecode.projects && viewItem =~ /^object/",
          "group": "2_open@2"
        },
        {
          "command": "iecode.rename",
          "when": "view == iecode.projects && viewItem =~ /^(object|folder|member)/",
          "group": "3_edit@1"
        },
        {
          "command": "iecode.delete",
          "when": "view == iecode.projects && viewItem =~ /^(object|folder|member)/",
          "group": "3_edit@2"
        },
        {
          "command": "iecode.build",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\..*\\.sln$/",
          "group": "0_build@1"
        },
        {
          "command": "iecode.check",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\..*\\.sln$/",
          "group": "0_build@2"
        },
        {
          "command": "iecode.clean",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\..*\\.sln$/",
          "group": "0_build@3"
        },
        {
          "command": "iecode.activate",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\.application\\.sln$/",
          "group": "0_build@4"
        },
        {
          "command": "iecode.libSave",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\.library\\.sln$/",
          "group": "0_build@5"
        },
        {
          "command": "iecode.encrypt",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\..*\\.sln$/",
          "group": "0_build@6"
        },
        {
          "command": "iecode.libraries",
          "when": "view == iecode.projects && viewItem =~ /^reference/",
          "group": "inline"
        },
        {
          "command": "iecode.libraries",
          "when": "view == iecode.projects && viewItem =~ /^(reference|references)/",
          "group": "1_add@1"
        }
      ],
      "commandPalette": [
        {
          "command": "iecode.addMember",
          "when": "false"
        },
        {
          "command": "iecode.rename",
          "when": "false"
        },
        {
          "command": "iecode.delete",
          "when": "false"
        },
        {
          "command": "iecode.addFolder",
          "when": "false"
        },
        {
          "command": "iecode.revealMember",
          "when": "false"
        },
        {
          "command": "iecode.build",
          "when": "isWindows"
        },
        {
          "command": "iecode.check",
          "when": "isWindows"
        },
        {
          "command": "iecode.clean",
          "when": "isWindows"
        },
        {
          "command": "iecode.activate",
          "when": "isWindows"
        },
        {
          "command": "iecode.libSave",
          "when": "isWindows"
        },
        {
          "command": "iecode.encrypt",
          "when": "isWindows"
        },
        {
          "command": "iecode.buildWorkspace",
          "when": "isWindows"
        },
        {
          "command": "iecode.buildAffected",
          "when": "isWindows"
        }
      ]
    },
    "keybindings": [
      {
        "command": "iecode.build",
        "key": "ctrl+shift+b",
        "when": "resourceScheme == iecode"
      }
    ],
    "configuration": {
      "title": "IECode",
      "properties": {
        "iecode.openAsST": {
          "type": "boolean",
          "default": true,
          "description": "Open TwinCAT object files as Structured Text instead of XML."
        },
        "iecode.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `iecode` CLI. Empty: `iecode` from PATH."
        },
        "iecode.tcVersion": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "TwinCAT version for build and activate: `auto`, `4024`, `4026` or an exact build like `4024.66`."
        },
        "iecode.platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Target platforms to build, e.g. `TwinCAT RT (x64)`. Empty: the active platform."
        },
        "iecode.targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "AMS NetIds offered when activating."
        },
        "iecode.restartAfterActivate": {
          "type": "boolean",
          "default": true,
          "description": "Restart TwinCAT in run mode after activating."
        },
        "iecode.libraryOutput": {
          "type": "string",
          "default": "dist",
          "description": "Folder (relative to the solution) for saved libraries."
        },
        "iecode.showXae": {
          "type": "boolean",
          "default": false,
          "description": "Show the TwinCAT XAE window while the CLI works (debugging)."
        },
        "iecode.libraryRepository": {
          "type": "string",
          "default": "",
          "markdownDescription": "TwinCAT library repository folder (`<vendor>/<library>/<version>`). Empty: `%TWINCAT3DIR%\\Components\\Plc\\Managed Libraries`."
        },
        "iecode.librarySources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra folders with library files named `<Name>_<Version>.library` (e.g. a shared drive)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iecode",
          "title": "IECode",
          "icon": "resources/iecode.svg"
        }
      ]
    },
    "views": {
      "iecode": [
        {
          "id": "iecode.projects",
          "name": "Projects",
          "icon": "resources/iecode.svg",
          "contextualTitle": "IECode"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "iecode.projects",
        "contents": "No TwinCAT projects found in this workspace.\nOpen a folder with a .sln, .tsproj or .plcproj, or add one to the workspace.\n[Open Folder](command:vscode.openFolder)",
        "when": "!iecode.hasProjects"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "npx @vscode/vsce@3.2.1 package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "typescript": "5.6.3"
  }
}
