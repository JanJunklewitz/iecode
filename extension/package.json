{
  "name": "iecode",
  "displayName": "IECode – Structured Text for TwinCAT",
  "description": "Structured Text for TwinCAT in VS Code: edit .TcPOU/.TcDUT/.TcGVL/.TcIO as plain ST, browse and extend PLC projects, workspaces with libraries and applications, view and edit .TcVIS visualizations, build and deploy with the iecode CLI.",
  "version": "0.1.1",
  "publisher": "iecode",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "pricing": "Free",
  "author": "Jan Junklewitz",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanJunklewitz/iecode.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/JanJunklewitz/iecode#readme",
  "bugs": {
    "url": "https://github.com/JanJunklewitz/iecode/issues"
  },
  "keywords": [
    "twincat",
    "structured text",
    "iec 61131-3",
    "plc",
    "st",
    "automation",
    "tcpou"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "bin": {
    "iecode-st": "./out/src/cli.js"
  },
  "activationEvents": [
    "onFileSystem:iecode",
    "onFileSystem:iecode-rev",
    "onFileSystem:iecode-src",
    "onFileSystem:iecode-io",
    "onFileSystem:iecode-lib",
    "onCustomEditor:iecode.visuEditor",
    "workspaceContains:**/*.{TcPOU,TcDUT,TcGVL,TcIO,TcVIS,plcproj,tsproj,tspproj}"
  ],
  "contributes": {
    "languages": [
      {
        "id": "twincat-st",
        "aliases": [
          "TwinCAT Structured Text"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "xml",
        "extensions": [
          ".TcPOU",
          ".TcDUT",
          ".TcGVL",
          ".TcIO",
          ".TcTTO",
          ".TcVIS"
        ]
      }
    ],
    "grammars": [
      {
        "language": "twincat-st",
        "scopeName": "source.twincat-st",
        "path": "./syntaxes/twincat-st.tmLanguage.json"
      },
      {
        "scopeName": "text.xml.twincat-cdata",
        "path": "./syntaxes/cdata-injection.tmLanguage.json",
        "injectTo": [
          "text.xml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.twincat-st": "twincat-st"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "iecode.visuEditor",
        "displayName": "IECode Visualization Editor",
        "selector": [
          {
            "filenamePattern": "*.TcVIS"
          }
        ],
        "priority": "default"
      }
    ],
    "snippets": [
      {
        "language": "twincat-st",
        "path": "./snippets.json"
      }
    ],
    "commands": [
      {
        "command": "iecode.openAsST",
        "title": "Open as Structured Text",
        "category": "IECode"
      },
      {
        "command": "iecode.openAsXml",
        "title": "Open as XML",
        "category": "IECode"
      },
      {
        "command": "iecode.build",
        "title": "Build",
        "category": "IECode",
        "icon": "$(play)"
      },
      {
        "command": "iecode.refresh",
        "title": "Refresh",
        "category": "IECode",
        "icon": "$(refresh)"
      },
      {
        "command": "iecode.addObject",
        "title": "Add Object…",
        "category": "IECode",
        "icon": "$(add)"
      },
      {
        "command": "iecode.addMember",
        "title": "Add Method / Property / Action…",
        "category": "IECode",
        "icon": "$(add)"
      },
      {
        "command": "iecode.addFolder",
        "title": "New Folder…",
        "category": "IECode",
        "icon": "$(new-folder)"
      },
      {
        "command": "iecode.rename",
        "title": "Rename…",
        "category": "IECode"
      },
      {
        "command": "iecode.delete",
        "title": "Delete",
        "category": "IECode"
      },
      {
        "command": "iecode.revealMember",
        "title": "Go to Member",
        "category": "IECode"
      },
      {
        "command": "iecode.showGraph",
        "title": "Show Dependency Graph",
        "category": "IECode",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "iecode.check",
        "title": "Check All Objects",
        "category": "IECode",
        "icon": "$(checklist)"
      },
      {
        "command": "iecode.clean",
        "title": "Clean",
        "category": "IECode"
      },
      {
        "command": "iecode.activate",
        "title": "Activate Configuration…",
        "category": "IECode",
        "icon": "$(zap)"
      },
      {
        "command": "iecode.libSave",
        "title": "Save as Library…",
        "category": "IECode",
        "icon": "$(package)"
      },
      {
        "command": "iecode.encrypt",
        "title": "Encrypt / Protect…",
        "category": "IECode",
        "icon": "$(lock)"
      },
      {
        "command": "iecode.buildWorkspace",
        "title": "Build Workspace",
        "category": "IECode",
        "icon": "$(run-all)"
      },
      {
        "command": "iecode.buildAffected",
        "title": "Build Affected Projects",
        "category": "IECode",
        "icon": "$(run-errors)"
      },
      {
        "command": "iecode.selectProject",
        "title": "Select Active Project…",
        "category": "IECode"
      },
      {
        "command": "iecode.selectTcVersion",
        "title": "Select TwinCAT Version…",
        "category": "IECode"
      },
      {
        "command": "iecode.libraries",
        "title": "Manage Libraries",
        "category": "IECode",
        "icon": "$(library)"
      },
      {
        "command": "iecode.setup",
        "title": "Set up this PC…",
        "category": "IECode"
      },
      {
        "command": "iecode.installCli",
        "title": "Install CLI…",
        "category": "IECode"
      },
      {
        "command": "iecode.compareWithHead",
        "title": "Compare with HEAD (ST)",
        "category": "IECode",
        "icon": "$(git-compare)"
      },
      {
        "command": "iecode.compareWithCommit",
        "title": "Compare with Commit… (ST)",
        "category": "IECode"
      },
      {
        "command": "iecode.compareCommits",
        "title": "Compare Two Commits… (ST)",
        "category": "IECode"
      },
      {
        "command": "iecode.selectForCompare",
        "title": "Select for Compare (ST)",
        "category": "IECode"
      },
      {
        "command": "iecode.compareWithSelected",
        "title": "Compare with Selected (ST)",
        "category": "IECode"
      },
      {
        "command": "iecode.setupGitDiff",
        "title": "Show ST in git diff (set up textconv)…",
        "category": "IECode"
      },
      {
        "command": "iecode.ioLinks",
        "title": "IO Links…",
        "category": "IECode",
        "icon": "$(plug)"
      },
      {
        "command": "iecode.ioLinksDiff",
        "title": "Compare IO Links with HEAD (YAML)",
        "category": "IECode",
        "icon": "$(plug)"
      },
      {
        "command": "iecode.ioLinksDiffCommit",
        "title": "Compare IO Links with Commit… (YAML)",
        "category": "IECode"
      },
      {
        "command": "iecode.scmCompareWithHead",
        "title": "Compare with HEAD (ST / IO links)"
      },
      {
        "command": "iecode.scmCompareWithCommit",
        "title": "Compare with Commit… (ST / IO links)"
      },
      {
        "command": "iecode.openVisuEditor",
        "title": "Open in Visualization Editor",
        "category": "IECode",
        "icon": "$(layout)"
      },
      {
        "command": "iecode.openVisuText",
        "title": "Open Visualization as Text (YAML)",
        "category": "IECode",
        "icon": "$(list-flat)"
      },
      {
        "command": "iecode.adsInterface",
        "title": "ADS Interface…",
        "category": "IECode",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "iecode.ioLinkRefresh",
        "title": "Refresh IO-Link",
        "category": "IECode",
        "icon": "$(refresh)"
      },
      {
        "command": "iecode.ioLinkSaveIndependent",
        "title": "Save as Independent Project File",
        "category": "IECode",
        "icon": "$(save-as)"
      },
      {
        "command": "iecode.ioLinkSaveAllIndependent",
        "title": "Save All Devices as Independent Project Files",
        "category": "IECode",
        "icon": "$(save-all)"
      },
      {
        "command": "iecode.ioLinkReveal",
        "title": "Reveal in Project File",
        "category": "IECode",
        "icon": "$(go-to-file)"
      },
      {
        "command": "iecode.ioLinkExplorer",
        "title": "Open IO-Link Explorer",
        "category": "IECode",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "iecode.openVisuEditor",
          "when": "resourceExtname =~ /\\\\.TcVIS$/i",
          "group": "navigation"
        },
        {
          "command": "iecode.openVisuText",
          "when": "resourceExtname =~ /\\\\.TcVIS$/i",
          "group": "navigation"
        },
        {
          "command": "iecode.openAsST",
          "when": "resourceExtname =~ /\\\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i",
          "group": "navigation"
        },
        {
          "command": "iecode.openAsXml",
          "when": "resourceExtname =~ /\\\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i",
          "group": "navigation"
        },
        {
          "submenu": "iecode.compare",
          "when": "resourceExtname =~ /\\\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i",
          "group": "3_compare"
        },
        {
          "command": "iecode.ioLinksDiff",
          "when": "resourceExtname =~ /\\\\.(tsproj|xti)$/i",
          "group": "3_compare"
        },
        {
          "command": "iecode.ioLinksDiffCommit",
          "when": "resourceExtname =~ /\\\\.(tsproj|xti)$/i",
          "group": "3_compare"
        }
      ],
      "editor/title": [
        {
          "command": "iecode.openVisuEditor",
          "when": "resourceScheme == file && resourceExtname =~ /\\\\.TcVIS$/i && activeCustomEditorId != iecode.visuEditor"
        },
        {
          "command": "iecode.openAsST",
          "when": "resourceScheme == file && resourceExtname =~ /\\\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i"
        },
        {
          "command": "iecode.openAsXml",
          "when": "resourceScheme == iecode"
        },
        {
          "command": "iecode.compareWithHead",
          "when": "resourceScheme == iecode",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "iecode.addObject",
          "when": "view == iecode.projects",
          "group": "navigation@1"
        },
        {
          "command": "iecode.libraries",
          "when": "view == iecode.projects",
          "group": "navigation@2"
        },
        {
          "command": "iecode.showGraph",
          "when": "view == iecode.projects",
          "group": "navigation@2"
        },
        {
          "command": "iecode.refresh",
          "when": "view == iecode.projects",
          "group": "navigation@3"
        },
        {
          "command": "iecode.buildWorkspace",
          "when": "isWindows && view == iecode.projects",
          "group": "1_build@1"
        },
        {
          "command": "iecode.buildAffected",
          "when": "isWindows && view == iecode.projects",
          "group": "1_build@2"
        },
        {
          "command": "iecode.setup",
          "when": "isWindows && view == iecode.projects",
          "group": "2_settings@0"
        },
        {
          "command": "iecode.selectProject",
          "when": "view == iecode.projects",
          "group": "2_settings@1"
        },
        {
          "command": "iecode.selectTcVersion",
          "when": "view == iecode.projects",
          "group": "2_settings@2"
        },
        {
          "command": "iecode.ioLinks",
          "when": "view == iecode.projects",
          "group": "2_settings@3"
        },
        {
          "command": "iecode.adsInterface",
          "when": "view == iecode.projects",
          "group": "2_settings@4"
        },
        {
          "command": "iecode.setupGitDiff",
          "when": "view == iecode.projects",
          "group": "2_settings@5"
        },
        {
          "command": "iecode.ioLinkExplorer",
          "when": "view == iecode.ioLink",
          "group": "navigation@0"
        },
        {
          "command": "iecode.ioLinkSaveAllIndependent",
          "when": "view == iecode.ioLink",
          "group": "navigation@1"
        },
        {
          "command": "iecode.ioLinkRefresh",
          "when": "view == iecode.ioLink",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "iecode.addObject",
          "when": "view == iecode.projects && viewItem =~ /^(unit|folder)/",
          "group": "inline"
        },
        {
          "command": "iecode.addObject",
          "when": "view == iecode.projects && viewItem =~ /^(unit|folder)/",
          "group": "1_add@1"
        },
        {
          "command": "iecode.addFolder",
          "when": "view == iecode.projects && viewItem =~ /^(unit|folder)/",
          "group": "1_add@2"
        },
        {
          "command": "iecode.addMember",
          "when": "view == iecode.projects && viewItem =~ /^object\\.(FUNCTION_BLOCK|PROGRAM|INTERFACE)$/",
          "group": "inline"
        },
        {
          "command": "iecode.addMember",
          "when": "view == iecode.projects && viewItem =~ /^object\\.(FUNCTION_BLOCK|PROGRAM|INTERFACE)$/",
          "group": "1_add@1"
        },
        {
          "command": "iecode.openAsST",
          "when": "view == iecode.projects && viewItem =~ /^object/",
          "group": "2_open@1"
        },
        {
          "command": "iecode.openAsXml",
          "when": "view == iecode.projects && viewItem =~ /^object/",
          "group": "2_open@2"
        },
        {
          "command": "iecode.rename",
          "when": "view == iecode.projects && viewItem =~ /^(object|folder|member)/",
          "group": "3_edit@1"
        },
        {
          "command": "iecode.delete",
          "when": "view == iecode.projects && viewItem =~ /^(object|folder|member)/",
          "group": "3_edit@2"
        },
        {
          "command": "iecode.build",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\..*\\.sln$/",
          "group": "0_build@1"
        },
        {
          "command": "iecode.check",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\..*\\.sln$/",
          "group": "0_build@2"
        },
        {
          "command": "iecode.clean",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\..*\\.sln$/",
          "group": "0_build@3"
        },
        {
          "command": "iecode.activate",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\.application\\.sln$/",
          "group": "0_build@4"
        },
        {
          "command": "iecode.libSave",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\.library\\.sln$/",
          "group": "0_build@5"
        },
        {
          "command": "iecode.encrypt",
          "when": "isWindows && view == iecode.projects && viewItem =~ /^unit\\..*\\.sln$/",
          "group": "0_build@6"
        },
        {
          "command": "iecode.libraries",
          "when": "view == iecode.projects && viewItem =~ /^reference/",
          "group": "inline"
        },
        {
          "command": "iecode.libraries",
          "when": "view == iecode.projects && viewItem =~ /^(reference|references)/",
          "group": "1_add@1"
        },
        {
          "submenu": "iecode.compare",
          "when": "view == iecode.projects && viewItem =~ /^object\\.(?!encrypted)/",
          "group": "2_open@3"
        },
        {
          "command": "iecode.ioLinks",
          "when": "view == iecode.projects && viewItem =~ /^unit\\.(application|library)\\.sln$/",
          "group": "0_build@7"
        },
        {
          "command": "iecode.ioLinks",
          "when": "view == iecode.projects && viewItem == system",
          "group": "0_build@7"
        },
        {
          "command": "iecode.ioLinks",
          "when": "view == iecode.projects && viewItem == system",
          "group": "inline"
        },
        {
          "command": "iecode.adsInterface",
          "when": "view == iecode.projects && viewItem =~ /^unit\\./",
          "group": "0_build@8"
        },
        {
          "command": "iecode.ioLinkSaveIndependent",
          "when": "view == iecode.ioLink && viewItem == iolink.master",
          "group": "inline"
        },
        {
          "command": "iecode.ioLinkSaveIndependent",
          "when": "view == iecode.ioLink && viewItem == iolink.master",
          "group": "1_save@1"
        },
        {
          "command": "iecode.ioLinkReveal",
          "when": "view == iecode.ioLink && viewItem =~ /^iolink\\.master/",
          "group": "2_open@1"
        },
        {
          "command": "iecode.ioLinkSaveAllIndependent",
          "when": "view == iecode.ioLink && viewItem == iolink.project",
          "group": "1_save@1"
        },
        {
          "command": "iecode.ioLinkExplorer",
          "when": "view == iecode.ioLink && viewItem =~ /^iolink\\.master/",
          "group": "2_open@0"
        },
        {
          "command": "iecode.ioLinkExplorer",
          "when": "view == iecode.projects && viewItem == system",
          "group": "0_build@8"
        }
      ],
      "commandPalette": [
        {
          "command": "iecode.addMember",
          "when": "false"
        },
        {
          "command": "iecode.rename",
          "when": "false"
        },
        {
          "command": "iecode.delete",
          "when": "false"
        },
        {
          "command": "iecode.addFolder",
          "when": "false"
        },
        {
          "command": "iecode.revealMember",
          "when": "false"
        },
        {
          "command": "iecode.build",
          "when": "isWindows"
        },
        {
          "command": "iecode.check",
          "when": "isWindows"
        },
        {
          "command": "iecode.clean",
          "when": "isWindows"
        },
        {
          "command": "iecode.activate",
          "when": "isWindows"
        },
        {
          "command": "iecode.libSave",
          "when": "isWindows"
        },
        {
          "command": "iecode.encrypt",
          "when": "isWindows"
        },
        {
          "command": "iecode.buildWorkspace",
          "when": "isWindows"
        },
        {
          "command": "iecode.buildAffected",
          "when": "isWindows"
        },
        {
          "command": "iecode.selectForCompare",
          "when": "false"
        },
        {
          "command": "iecode.scmCompareWithHead",
          "when": "false"
        },
        {
          "command": "iecode.scmCompareWithCommit",
          "when": "false"
        },
        {
          "command": "iecode.ioLinkSaveIndependent",
          "when": "false"
        },
        {
          "command": "iecode.ioLinkReveal",
          "when": "false"
        }
      ],
      "iecode.compare": [
        {
          "command": "iecode.compareWithHead",
          "group": "1@1"
        },
        {
          "command": "iecode.compareWithCommit",
          "group": "1@2"
        },
        {
          "command": "iecode.compareCommits",
          "group": "1@3"
        },
        {
          "command": "iecode.selectForCompare",
          "group": "2@1"
        },
        {
          "command": "iecode.compareWithSelected",
          "group": "2@2"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "iecode.compare",
          "when": "resourceScheme == iecode || resourceExtname =~ /\\\\.(TcPOU|TcDUT|TcGVL|TcIO)$/i"
        },
        {
          "command": "iecode.ioLinksDiff",
          "when": "resourceExtname =~ /\\\\.(tsproj|xti)$/i",
          "group": "3_compare"
        },
        {
          "command": "iecode.ioLinksDiffCommit",
          "when": "resourceExtname =~ /\\\\.(tsproj|xti)$/i",
          "group": "3_compare"
        }
      ],
      "scm/resourceState/context": [
        {
          "submenu": "iecode.scmCompare",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "iecode.scmCompare": [
        {
          "command": "iecode.scmCompareWithHead",
          "group": "1@1"
        },
        {
          "command": "iecode.scmCompareWithCommit",
          "group": "1@2"
        },
        {
          "command": "iecode.ioLinks",
          "group": "2@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "iecode.build",
        "key": "ctrl+shift+b",
        "when": "resourceScheme == iecode"
      }
    ],
    "configuration": {
      "title": "IECode",
      "properties": {
        "iecode.openAsST": {
          "type": "boolean",
          "default": true,
          "description": "Open TwinCAT object files as Structured Text instead of XML."
        },
        "iecode.greenComments": {
          "type": "boolean",
          "default": true,
          "description": "Show comments in Structured Text green, also in themes that render comments grey. Not applied in high contrast themes; turn off to use the theme's (or your own token) colors."
        },
        "iecode.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `iecode` CLI. Empty: `iecode` from PATH."
        },
        "iecode.tcVersion": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "TwinCAT version for build and activate: `auto`, `4024`, `4026` or an exact build like `4024.66`."
        },
        "iecode.platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Target platforms to build, e.g. `TwinCAT RT (x64)`. Empty: the active platform."
        },
        "iecode.targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "AMS NetIds offered when activating."
        },
        "iecode.restartAfterActivate": {
          "type": "boolean",
          "default": true,
          "description": "Restart TwinCAT in run mode after activating."
        },
        "iecode.libraryOutput": {
          "type": "string",
          "default": "dist",
          "description": "Folder (relative to the solution) for saved libraries."
        },
        "iecode.showXae": {
          "type": "boolean",
          "default": false,
          "description": "Show the TwinCAT XAE window while the CLI works (debugging)."
        },
        "iecode.libraryRepository": {
          "type": "string",
          "default": "",
          "markdownDescription": "TwinCAT library repository folder (`<vendor>/<library>/<version>`). Empty: `%TWINCAT3DIR%\\Components\\Plc\\Managed Libraries`."
        },
